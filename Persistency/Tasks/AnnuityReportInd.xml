  <Code>Overrides Sub RunCode(Optional OutputResults As Boolean = True)
    ' Group by record
    DefineGrouping(Function(var) "Record = " &amp; Record.Number)
    
    ' Output delimiter
    GenCore.WriteProjectionResults.DefaultDelimiter = Chr(9)
    
    ' Filter output to first 12 time periods only
    Me.ResultsFilter.SetRows(Function(row) row &lt;= 6)

    ' Configure result output for this task
    ResultOptions.Apply(WriteTypes.Records, Me)
    ResultOptions.Apply(1, WriteTypes.None, Me)

    ' Run the projection
    ExecuteRecords(OutputResults)

    ' === Merge and consolidate result files ===
    If OutputResults Then
        Dim task As Model = Me
        ' Merge column function results
        Dim colResults = MergeResults.ColumnSubTotals(task)
        FileText.Write(Me.Properties.ResultsFolder &amp; "MergedColumnResults_Records.txt", colResults)

    End If
End Sub</Code>
